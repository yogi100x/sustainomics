---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AdBlock from "../../components/AdBlock.astro";
import { getSection } from "../../config/site-nav";

const section = getSection("video")!;
const CATEGORIES = section.subtabs;
const active = Astro.url.searchParams.get("cat") ?? "";

const { entries: videos, cacheHint } = await getEmDashCollection("videos", {
	orderBy: { video_date: "desc" },
	limit: 80,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function ytId(u?: string | null) {
	if (!u) return null;
	const m = u.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([-\w]{11})/);
	return m ? m[1] : null;
}

function ytUrl(id: string) {
	return `https://www.youtube.com/watch?v=${id}`;
}

function hrefFor(video: (typeof videos)[number]) {
	const vid = ytId(video.data.video_url);
	return vid ? ytUrl(vid) : `/video/${video.id}`;
}

function thumb(video: (typeof videos)[number]) {
	const vid = ytId(video.data.video_url);
	return vid ? `https://i.ytimg.com/vi/${vid}/hqdefault.jpg` : null;
}

const fmt = (d: Date | string | null | undefined) => {
	if (!d) return null;
	const date = d instanceof Date ? d : new Date(d as string);
	return isNaN(date.getTime())
		? null
		: date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
};

const filtered = active
	? videos.filter((v) => (v.data.category ?? "").toLowerCase() === active.toLowerCase())
	: videos;
const featured = filtered.slice(0, 3);

const videosByCategory: Record<string, typeof videos> = {};
for (const category of CATEGORIES) videosByCategory[category.label] = [];
for (const video of videos) {
	const key =
		CATEGORIES.find((category) => category.label.toLowerCase() === (video.data.category ?? "").toLowerCase())
			?.label ?? CATEGORIES[0].label;
	if (videosByCategory[key].length < 3) videosByCategory[key].push(video);
}
---

<Base title="Video — THE SUSTAINOMICS" description={section.blurb}>
	<div class="wrap">

		{/* ===== MASTHEAD ===== */}
		<header class="sec-head">
			<h1 class="sec-name">Video</h1>
			<p class="sec-sub">{section.blurb}</p>
		</header>

		{/* ===== VIDEO TABS NAV ===== */}
		<nav class="show-tabs" aria-label="Video categories">
			<a href="/video" class:list={["show-tab", { "show-tab--on": !active }]}>All</a>
			{CATEGORIES.map((category) => (
				<a
					href={`/video?cat=${encodeURIComponent(category.label)}`}
					class:list={["show-tab", { "show-tab--on": active === category.label }]}
				>
					{category.label}
				</a>
			))}
		</nav>

		{filtered.length === 0 ? (
			<section class="empty">
				<h2>No videos in this category yet</h2>
				<p>Publish a video or choose another category.</p>
				<a class="btn" href="/video">All videos</a>
			</section>
		) : (
			<>
				{/* ===== FEATURED STRIP (latest 3) ===== */}
				<section class="featured-strip">
					{featured.map((video, i) => {
						const vid = ytId(video.data.video_url);
						const t = thumb(video);
						return (
							<a
								href={hrefFor(video)}
								{...(vid ? { "data-video-id": vid, "data-video-title": video.data.title } : {})}
								class:list={["feat-card", { "feat-card--lead": i === 0 }]}
							>
								<div class="feat-media">
									{video.data.thumbnail ? (
										<Image image={video.data.thumbnail} />
									) : t ? (
										<img src={t} alt={video.data.title} loading="lazy" />
									) : (
										<div class="feat-noimg" />
									)}
									<span class="feat-play" aria-hidden="true">▶</span>
								</div>
								<div class="feat-body">
									<span class="feat-kicker">{video.data.category || "Video"}</span>
									<h2 class="feat-title">{video.data.title}</h2>
									{video.data.excerpt && <p class="feat-dek">{video.data.excerpt}</p>}
									<div class="feat-meta">
										{video.data.duration && <span class="feat-dur">▶ {video.data.duration}</span>}
										{fmt(video.data.video_date) && <span class="feat-date">{fmt(video.data.video_date)}</span>}
									</div>
								</div>
							</a>
						);
					})}
				</section>

				<AdBlock placement="mid-page" />

				{/* ===== NAMED VIDEO BANDS ===== */}
				{!active && CATEGORIES.map((category) => {
					const categoryVideos = videosByCategory[category.label] ?? [];
					return (
						<section class="show-band" id={`show-${category.slug}`}>
							<div class="show-head">
								<div class="show-head-text">
									<h2 class="show-name">{category.label}</h2>
									{category.desc && <p class="show-desc">{category.desc}</p>}
								</div>
								<a href={`/video?cat=${encodeURIComponent(category.label)}`} class="show-all">All videos →</a>
							</div>
							{categoryVideos.length === 0 ? (
								<p class="show-empty">Videos coming soon.</p>
							) : (
								<div class="show-grid">
									{categoryVideos.map((video) => {
										const vid = ytId(video.data.video_url);
										const t = thumb(video);
										return (
											<a
												href={hrefFor(video)}
												{...(vid ? { "data-video-id": vid, "data-video-title": video.data.title } : {})}
												class="ep-card"
											>
												<div class="ep-media">
													{video.data.thumbnail ? (
														<Image image={video.data.thumbnail} />
													) : t ? (
														<img src={t} alt={video.data.title} loading="lazy" />
													) : (
														<div class="ep-noimg" />
													)}
													<span class="ep-play" aria-hidden="true">▶</span>
												</div>
												<div class="ep-body">
													<h3 class="ep-title">{video.data.title}</h3>
													{video.data.excerpt && <p class="ep-dek">{video.data.excerpt}</p>}
													<div class="ep-meta">
														{video.data.duration && <span class="ep-dur">▶ {video.data.duration}</span>}
														{fmt(video.data.video_date) && <span class="ep-date">{fmt(video.data.video_date)}</span>}
													</div>
												</div>
											</a>
										);
									})}
								</div>
							)}
						</section>
					);
				})}
			</>
		)}
	</div>

	<div class="video-lightbox" id="video-lightbox" hidden>
		<div class="video-lightbox-backdrop" data-close></div>
		<div class="video-lightbox-inner">
			<button type="button" class="video-lightbox-close" data-close aria-label="Close video">✕</button>
			<div class="video-lightbox-frame" id="video-lightbox-frame"></div>
		</div>
	</div>

	<script>
		const lightbox = document.getElementById("video-lightbox");
		const frame = document.getElementById("video-lightbox-frame");

		function openVideo(id: string, title: string) {
			if (!lightbox || !frame) return;
			frame.innerHTML = "";
			const iframe = document.createElement("iframe");
			iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
			iframe.title = title || "Video player";
			iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
			iframe.allowFullscreen = true;
			frame.appendChild(iframe);
			lightbox.hidden = false;
			document.body.style.overflow = "hidden";
		}

		function closeVideo() {
			if (!lightbox || !frame) return;
			lightbox.hidden = true;
			frame.innerHTML = "";
			document.body.style.overflow = "";
		}

		document.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			const link = target.closest<HTMLElement>("a[data-video-id]");
			if (link) {
				e.preventDefault();
				openVideo(link.dataset.videoId!, link.dataset.videoTitle ?? "");
				return;
			}
			if (target.closest("[data-close]")) closeVideo();
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && lightbox && !lightbox.hidden) closeVideo();
		});
	</script>
</Base>

<style>
	.wrap {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.sec-head {
		border-top: 2px solid var(--color-ink);
		padding-top: var(--spacing-3);
		margin-bottom: var(--spacing-6);
	}
	.sec-name {
		font-family: var(--font-serif, Georgia, serif);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		color: var(--color-ink);
	}
	.sec-sub {
		margin-top: var(--spacing-1);
		color: var(--color-muted);
		max-width: 60ch;
	}

	.show-tabs {
		display: flex;
		gap: var(--spacing-4);
		overflow-x: auto;
		scrollbar-width: none;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--spacing-8);
		padding-bottom: 0;
	}
	.show-tabs::-webkit-scrollbar { display: none; }
	.show-tab {
		flex: none;
		padding: var(--spacing-3) 0;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		white-space: nowrap;
		color: var(--color-text-secondary);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		margin-bottom: -1px;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}
	.show-tab:hover,
	.show-tab--on {
		color: var(--color-ink);
		border-bottom-color: var(--color-kicker);
	}

	.featured-strip {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: var(--spacing-6);
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-10);
		border-bottom: 1px solid var(--color-border);
	}
	.feat-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}
	.feat-card--lead { grid-column: span 1; }
	.feat-media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-surface);
	}
	.feat-media :global(img) {
		width: 100%; height: 100%; object-fit: cover;
		transition: transform 0.3s ease;
	}
	.feat-card:hover .feat-media :global(img) { transform: scale(1.03); }
	.feat-noimg { width: 100%; height: 100%; background: var(--color-surface); }
	.feat-play {
		position: absolute;
		top: 50%; left: 50%;
		transform: translate(-50%, -50%);
		width: 36px; height: 36px;
		background: rgba(0,0,0,0.6);
		color: #fff;
		border-radius: 50%;
		display: flex; align-items: center; justify-content: center;
		font-size: 13px; padding-left: 2px;
	}
	.feat-body { display: flex; flex-direction: column; gap: var(--spacing-2); }
	.feat-kicker {
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-kicker);
	}
	.feat-title {
		font-family: var(--font-serif, Georgia, serif);
		font-size: var(--font-size-xl);
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-ink);
		margin: 0;
	}
	.feat-card:hover .feat-title { color: var(--color-accent); }
	.feat-dek {
		font-size: var(--font-size-sm);
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.feat-meta {
		display: flex;
		gap: var(--spacing-3);
		align-items: center;
		margin-top: auto;
	}
	.feat-dur, .feat-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.show-band {
		margin-bottom: var(--spacing-12);
		padding-top: var(--spacing-8);
		border-top: 2px solid var(--color-ink);
	}
	.show-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-6);
	}
	.show-name {
		font-family: var(--font-sans);
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-ink);
		margin: 0;
	}
	.show-desc {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin: var(--spacing-1) 0 0;
		max-width: 52ch;
	}
	.show-all {
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-muted);
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
		padding-top: 4px;
	}
	.show-all:hover { color: var(--color-accent); }
	.show-empty {
		color: var(--color-muted);
		font-style: italic;
		font-size: var(--font-size-sm);
	}
	.show-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
	}

	.ep-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}
	.ep-media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-surface);
	}
	.ep-media :global(img) {
		width: 100%; height: 100%; object-fit: cover;
		transition: transform 0.3s ease;
	}
	.ep-card:hover .ep-media :global(img) { transform: scale(1.03); }
	.ep-noimg { width: 100%; height: 100%; background: var(--color-surface); }
	.ep-play {
		position: absolute;
		top: 50%; left: 50%;
		transform: translate(-50%, -50%);
		width: 32px; height: 32px;
		background: rgba(0,0,0,0.6);
		color: #fff;
		border-radius: 50%;
		display: flex; align-items: center; justify-content: center;
		font-size: 11px; padding-left: 2px;
	}
	.ep-body { display: flex; flex-direction: column; gap: var(--spacing-1); }
	.ep-title {
		font-family: var(--font-serif, Georgia, serif);
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: 1.3;
		color: var(--color-ink);
		margin: 0;
	}
	.ep-card:hover .ep-title { color: var(--color-accent); }
	.ep-dek {
		font-size: var(--font-size-sm);
		line-height: 1.45;
		color: var(--color-text-secondary);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.ep-meta { display: flex; gap: var(--spacing-3); align-items: center; }
	.ep-dur, .ep-date { font-size: var(--font-size-xs); color: var(--color-muted); }

	.empty { text-align: center; padding: var(--spacing-20) var(--spacing-6); }
	.empty h2 { font-family: var(--font-serif, Georgia, serif); font-size: var(--font-size-2xl); }
	.empty p { color: var(--color-muted); margin-top: var(--spacing-2); }
	.btn {
		display: inline-block; margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-ink); color: #fff;
		text-decoration: none; font-size: var(--font-size-sm); font-weight: 600;
	}

	@media (max-width: 900px) {
		.featured-strip { grid-template-columns: 1fr 1fr; }
		.featured-strip .feat-card:last-child { display: none; }
		.show-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 600px) {
		.featured-strip { grid-template-columns: 1fr; }
		.show-grid { grid-template-columns: 1fr; }
	}

	.video-lightbox {
		position: fixed;
		inset: 0;
		z-index: 2000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-6);
	}
	/* The class's `display: flex` outranks the UA `[hidden]{display:none}`
	   rule, so without this the overlay shows on load and blocks the page. */
	.video-lightbox[hidden] {
		display: none;
	}
	.video-lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
	}
	.video-lightbox-inner {
		position: relative;
		width: min(1100px, 100%);
	}
	.video-lightbox-close {
		position: absolute;
		top: var(--spacing-3);
		right: var(--spacing-3);
		z-index: 2;
		background: rgba(0, 0, 0, 0.65);
		border: none;
		border-radius: 50%;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		padding: 0;
	}
	.video-lightbox-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
	}
	.video-lightbox-frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
