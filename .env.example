# Copy to .env and fill in. `docker compose` reads .env automatically.

# Stable secret that encrypts CMS secrets at rest. Generate once and keep it
# constant forever — changing it makes existing encrypted data unreadable.
# Generate: emdash_enc_v1_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_change_me

# Public URL the site is reachable at (no trailing slash).
EMDASH_SITE_URL=http://localhost:3000

# Host port to publish the app on.
PORT=3000
