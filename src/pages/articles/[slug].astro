---
import { getEmDashEntry, getEmDashCollection, decodeSlug } from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AdBlock from "../../components/AdBlock.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: article, cacheHint } = await getEmDashEntry("articles", slug);
if (!article) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Resolve the parent issue from a.data.issue (a magazine ULID).
const issueRef = article.data.issue;
let issue: any = null;
if (issueRef) {
	const { entries: mags } = await getEmDashCollection("magazines").catch(
		() => ({ entries: [] as any[] }),
	);
	issue =
		(mags ?? []).find((m: any) => m.data.id === issueRef || m.id === issueRef) ?? null;
}

const bylines = article.data.bylines ?? [];
const bylineNames =
	bylines.length > 0
		? bylines.map((c: any) => c?.byline?.displayName).filter(Boolean).join(", ")
		: null;

const publishDate =
	(article.data.publishedAt ?? article.data.createdAt)?.toLocaleDateString?.("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;

const section = article.data.mag_section || "Magazine";
---

<Base
	title={article.data.title}
	description={article.data.excerpt}
	type="article"
	content={{ collection: "articles", id: article.data.id, slug }}
>
	<div class="read-progress" id="read-progress" aria-hidden="true"></div>
	<article class="article">
		{
			article.data.featured_image && (
				<div class="article-hero">
					<Image image={article.data.featured_image} />
				</div>
			)
		}

		<div class="article-grid">
			{/* Left gutter: Meta information */}
			<aside class="article-meta-col">
				<div class="meta-sticky">
					{
						issue ? (
							<a class="back" href={`/magazine/${issue.id}`}>
								‹ Back to {issue.data.title}
							</a>
						) : (
							<a class="back" href="/magazine">
								‹ Back to Magazine
							</a>
						)
					}
					{
						bylines.length > 0 && (
							<div class="meta-block byline-block">
								<span class="meta-label">
									{bylines.length === 1 ? "Author" : "Authors"}
								</span>
								<div class="bylines">
									{bylines.map((credit: any) => (
										<div class="byline">
											{credit.byline.avatarMediaId && (
												<img
													src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
													alt={credit.byline.displayName}
													class="byline-avatar"
												/>
											)}
											<div class="byline-info">
												<span class="byline-name">
													{credit.byline.displayName}
												</span>
												{credit.roleLabel && (
													<span class="byline-role">{credit.roleLabel}</span>
												)}
											</div>
										</div>
									))}
								</div>
							</div>
						)
					}
					{
						publishDate && (
							<div class="meta-block">
								<span class="meta-label">Published</span>
								<time class="meta-value">{publishDate}</time>
							</div>
						)
					}
					{
						article.data.read_time && (
							<div class="meta-block">
								<span class="meta-label">Reading time</span>
								<span class="meta-value">{article.data.read_time}</span>
							</div>
						)
					}
					<div class="meta-block">
						<span class="meta-label">Section</span>
						<span class="meta-value">{section}</span>
					</div>
				</div>
			</aside>

			{/* Main content */}
			<div class="article-main">
				<header class="article-header">
					<span class="kick">{section}</span>
					<h1 class="article-title">{article.data.title}</h1>
					{article.data.excerpt && <p class="article-excerpt">{article.data.excerpt}</p>}
					<div class="article-meta">
						{bylineNames && <span class="meta-byline">{bylineNames}</span>}
						{bylineNames && (publishDate || article.data.read_time) && (
							<span class="meta-dot" />
						)}
						{publishDate && <time>{publishDate}</time>}
						{publishDate && article.data.read_time && <span class="meta-dot" />}
						{article.data.read_time && <span>{article.data.read_time}</span>}
					</div>
				</header>

				<AdBlock placement="mid-page" />
				<div class="article-content">
					<PortableText value={article.data.content} />
				</div>

				<div class="article-share">
					<span class="share-label">Share</span>
					<a
						href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.data.title ?? "")}&url=${encodeURIComponent(Astro.url.href)}`}
						target="_blank" rel="noopener"
						class="share-btn"
						aria-label="Share on X"
					>
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
						X
					</a>
					<a
						href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
						target="_blank" rel="noopener"
						class="share-btn"
						aria-label="Share on LinkedIn"
					>
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
						LinkedIn
					</a>
					<button type="button" class="share-btn share-copy" data-copy-url={Astro.url.href}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
						<span>Copy link</span>
					</button>
				</div>

				<footer class="article-foot">
					{
						issue && (
							<a class="foot-link" href={`/magazine/${issue.id}`}>
								‹ Back to {issue.data.title}
							</a>
						)
					}
				</footer>
			</div>

			{/* Right gutter: TOC + Sidebar widgets */}
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<nav class="toc" aria-label="Table of contents">
						<h4 class="toc-title">On this page</h4>
						<div class="toc-content" id="toc-content">
							<!-- Populated by JS -->
						</div>
					</nav>
					<div class="sidebar-widgets">
						<WidgetArea name="sidebar" />
						<AdBlock placement="article" />
					</div>
				</div>
			</aside>
		</div>
	</article>

	<script>
		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				// Hide TOC if no headings
				const toc = document.querySelector(".toc") as HTMLElement | null;
				if (toc) toc.style.display = "none";
				return;
			}

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();

		// Reading progress bar
		const bar = document.getElementById("read-progress");
		if (bar) {
			window.addEventListener("scroll", () => {
				const d = document.documentElement;
				const pct = d.scrollTop / (d.scrollHeight - d.clientHeight);
				bar.style.transform = `scaleX(${Math.min(pct, 1)})`;
			}, { passive: true });
		}

		// Copy link button
		document.querySelectorAll(".share-copy").forEach((btn) => {
			btn.addEventListener("click", () => {
				const url = (btn as HTMLElement).dataset.copyUrl ?? location.href;
				navigator.clipboard?.writeText(url).then(() => {
					const span = btn.querySelector("span");
					if (span) { span.textContent = "Copied!"; setTimeout(() => { span.textContent = "Copy link"; }, 2000); }
				});
			});
		});
	</script>
</Base>

<style>
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) 0 var(--spacing-16);
	}
	.read-progress {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		z-index: 200;
		transition: transform 0.1s linear;
	}
	.article-hero {
		margin: 0 var(--spacing-6) var(--spacing-10);
		border-radius: var(--radius-lg, var(--radius));
		overflow: hidden;
		background: var(--color-surface);
		max-height: 460px;
	}
	.article-hero :global(img) {
		width: 100%;
		height: auto;
		max-height: 460px;
		object-fit: cover;
	}

	/* Three-column grid */
	.article-grid {
		display: grid;
		grid-template-columns:
			var(--meta-col-width) minmax(0, var(--content-width))
			var(--gutter-width);
		gap: var(--spacing-10);
		justify-content: center;
		padding: 0 var(--spacing-6);
	}

	.meta-sticky {
		position: sticky;
		top: calc(var(--nav-height) + var(--spacing-8));
	}
	.back {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-muted);
		text-decoration: none;
		margin-bottom: var(--spacing-5);
	}
	.back:hover {
		color: var(--color-text);
	}
	.meta-block {
		margin-bottom: var(--spacing-6);
	}
	.meta-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
		margin-bottom: var(--spacing-1);
	}
	.meta-value {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}
	.bylines {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}
	.byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}
	.byline-avatar {
		width: var(--avatar-size-lg);
		height: var(--avatar-size-lg);
		border-radius: 50%;
		object-fit: cover;
	}
	.byline-info {
		display: flex;
		flex-direction: column;
	}
	.byline-name {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}
	.byline-role {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.article-main {
		min-width: 0;
	}
	.article-header {
		margin-bottom: var(--spacing-8);
	}
	.kick {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-kicker, var(--color-accent));
	}
	.article-title {
		font-family: var(--font-serif, Georgia, serif);
		font-size: clamp(2rem, 4vw, var(--font-size-4xl, 2.75rem));
		font-weight: 700;
		line-height: var(--leading-tight, 1.12);
		margin: var(--spacing-2) 0 var(--spacing-4);
	}
	.article-excerpt {
		font-size: var(--font-size-xl);
		line-height: var(--leading-relaxed, 1.5);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-4);
	}
	.article-meta {
		display: none;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-3);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}
	.meta-byline {
		font-weight: 600;
		color: var(--color-text-secondary);
	}
	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}
	.article-content {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed, 1.7);
	}
	.article-content :global(p) {
		margin-bottom: 1.5em;
	}
	.article-content :global(h2) {
		font-family: var(--font-serif, Georgia, serif);
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.6em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}
	.article-content :global(h3) {
		font-family: var(--font-serif, Georgia, serif);
		font-size: var(--font-size-xl);
		margin-top: 1.6em;
		margin-bottom: 0.5em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}
	.article-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-border);
		background: var(--color-bg-subtle);
		color: var(--color-text-secondary);
		font-style: italic;
	}
	.article-content :global(ul),
	.article-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}
	.article-content :global(li) {
		margin-bottom: 0.5em;
	}
	.article-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius-lg, var(--radius));
		width: 100%;
	}
	.article-content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-share {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border);
	}
	.share-label {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-right: var(--spacing-1);
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: var(--spacing-2) var(--spacing-3);
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s;
	}
	.share-btn:hover {
		border-color: var(--color-text);
		color: var(--color-text);
	}

	.article-foot {
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border);
	}
	.foot-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-muted);
		text-decoration: none;
	}
	.foot-link:hover {
		color: var(--color-text);
	}

	/* Right column: TOC + Sidebar */
	.sidebar-sticky {
		position: sticky;
		top: calc(var(--nav-height) + var(--spacing-8));
	}
	.toc {
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}
	.toc-title {
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
		margin-bottom: var(--spacing-3);
	}
	.toc-content :global(.toc-list) {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.toc-content :global(.toc-item) {
		margin-bottom: var(--spacing-1);
	}
	.toc-content :global(.toc-item--nested) {
		padding-left: var(--spacing-3);
	}
	.toc-content :global(.toc-link) {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		padding: var(--spacing-1) 0;
		transition: color var(--transition-fast);
		line-height: var(--leading-snug);
	}
	.toc-content :global(.toc-link:hover),
	.toc-content :global(.toc-link.active) {
		color: var(--color-text);
	}
	.sidebar-widgets :global(.widget-area) {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}
	.sidebar-widgets :global(.widget__title) {
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
		margin-bottom: var(--spacing-3);
	}

	@media (max-width: 1100px) {
		.article-grid {
			grid-template-columns: minmax(0, var(--content-width));
			gap: 0;
		}
		.article-meta-col,
		.article-sidebar {
			display: none;
		}
		.article-header .article-meta {
			display: flex;
		}
	}
	@media (max-width: 900px) {
		.article-hero {
			margin: var(--spacing-4) var(--spacing-4) var(--spacing-8);
			border-radius: var(--radius);
		}
		.article-grid {
			padding: 0 var(--spacing-4);
		}
	}
	@media (max-width: 600px) {
		.article-title {
			font-size: var(--font-size-3xl);
		}
		.article-excerpt {
			font-size: var(--font-size-lg);
		}
	}
</style>
